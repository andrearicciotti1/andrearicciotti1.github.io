---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NavBar from "../NavBar.astro";
import Marquee from "../Marquee.astro";
import { useTranslations, localize, runs, type Lang } from "../../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const L = (p: string) => localize(lang, p);

const timelineEn = [
  { year: "1995", title: "Born",                     body: "Rome, Italy." },
  { year: "2016", title: "First steps into directing", body: "Claudio Di Biagio's course La regia e l'idea at Artithesi." },
  { year: "2017", title: "Directorial debut",        body: "Web series Love: Edit, produced by Artithesi and ImageHunters." },
  { year: "2018", title: "SIAE SILLUMINA grant",     body: "Directed CLARK — a short film; a turning point." },
  { year: "2019 — 2023", title: "Trailer",             body: "Cut trailers for Cit Studio." },
  { year: "2019 — 2021", title: "Assistant editor & AD", body: "Bentornato Presidente, Permette Alberto Sordi?, Il Cacciatore S3, Ai Confini del Male." },
  { year: "2021 — 2023", title: "Assembly editor",   body: "Altrimenti ci Arrabbiamo, The Bad Guy, Shake." },
  { year: "2023 — 2024", title: "Lead editor",       body: "Pesci Piccoli (Prime Video), Hanno Ucciso l'Uomo Ragno (Sky)." },
  { year: "2024", title: "Combattere",               body: "Latest directorial work, produced by PunxFilm. Wrapped post in January." },
  { year: "2025 — now",  title: "Current",           body: "Editing Pesci Piccoli S2 and the documentary Benetton Formula. Edited Francesco Zampaglion's latest film, including its premiere in London." },
  { year: "2026", title: "Il Primo della Classe",    body: "Won the 8th edition of \"La Realtà che Non Esiste\" — in production with One More Pictures and Rai Cinema. Written and directed, starring Samuele Carrin. Selected for Venice." },
];

const timelineIt = [
  { year: "1995", title: "Nascita",                    body: "Roma, Italia." },
  { year: "2016", title: "Primi passi verso la regia", body: "Il corso di Claudio Di Biagio La regia e l'idea ad Artithesi." },
  { year: "2017", title: "Esordio alla regia",         body: "La web series Love: Edit, prodotta da Artithesi e ImageHunters." },
  { year: "2018", title: "Bando SIAE SILLUMINA",       body: "Regia di CLARK, un cortometraggio che è stato una svolta." },
  { year: "2019 — 2023", title: "Trailer",             body: "Montaggio trailer per Cit Studio." },
  { year: "2019 — 2021", title: "Assistente al montaggio e aiuto regia", body: "Bentornato Presidente, Permette? Alberto Sordi, Il Cacciatore 3, Ai Confini del Male." },
  { year: "2021 — 2023", title: "Montaggio di assemblaggio", body: "Altrimenti ci Arrabbiamo, The Bad Guy, Shake." },
  { year: "2023 — 2024", title: "Capo montatore",      body: "Pesci Piccoli (Prime Video), Hanno Ucciso l'Uomo Ragno (Sky)." },
  { year: "2024", title: "Combattere",                 body: "Ultimo lavoro da regista, prodotto da PunxFilm. Post chiusa a gennaio." },
  { year: "2025 — oggi", title: "Adesso",              body: "Montaggio di Pesci Piccoli 2 e del documentario Benetton Formula. Ho montato l'ultimo film di Federico Zampaglione, presentato in anteprima a Londra." },
  { year: "2026", title: "Il Primo della Classe",      body: "Vincitore dell'VIII edizione de \"La Realtà che Non Esiste\", prodotto da One More Pictures con Rai Cinema. Scritto e diretto, con Samuele Carrino. Selezionato a Venezia." },
];
const timeline = lang === "it" ? timelineIt : timelineEn;

const facts = [
  { k: t("bio.fact_based"),  v: t("bio.fact_based_v") },
  { k: t("bio.fact_langs"),  v: t("bio.fact_langs_v") },
  { k: t("bio.fact_exp"),    v: t("bio.fact_exp_v") },
  { k: t("bio.fact_tools"),  v: "Avid · Premiere · DaVinci" },
  { k: t("bio.fact_rep"),    v: t("bio.fact_rep_v") },
  { k: t("bio.fact_status"), v: t("bio.fact_status_v") },
];
---

<BaseLayout title={t("bio.title")} description={t("bio.desc")} lang={lang}>
  <NavBar active="bio" lang={lang} />

  <!-- HEAD -->
  <section class="head">
    <div class="head__top">
      <span class="mono">{t("bio.section")}</span>
      <span class="mono">{t("bio.est")}</span>
    </div>
    <h1 class="head__title display">
      <span>{t("bio.h1_a")}</span>
      <span class="serif-italic hot">{t("bio.h1_b")}</span>
      <span>{t("bio.h1_c")}</span>
      <span class="serif-italic hot">{t("bio.h1_d")}</span>
    </h1>
    <p class="head__lede">
      {t("bio.lede")}
    </p>
  </section>

  <!-- FACTS STRIP -->
  <section class="facts">
    {facts.map((f) => (
      <div class="fact">
        <div class="mono fact__k">{f.k}</div>
        <div class="fact__v display">{f.v}</div>
      </div>
    ))}
  </section>

  <!-- BODY -->
  <section class="body">
    <aside class="body__aside">
      <div class="mono body__label">{t("bio.cv_label")}</div>
      <div class="downloads">
        <a href="/assets/andrea-ricciotti-cv.pdf" download="Andrea Ricciotti - CV 2025.pdf" class="dl">
          <span class="display">{t("bio.cv")}</span>
          <span class="mono">PDF ↓</span>
        </a>
        <a href="https://letterboxd.com/andrearicciotti/" target="_blank" rel="noopener" class="dl">
          <span class="display">Letterboxd</span>
          <span class="mono">↗</span>
        </a>
        <a href="https://www.imdb.com/it/name/nm10527696/" target="_blank" rel="noopener" class="dl">
          <span class="display">IMDb</span>
          <span class="mono">↗</span>
        </a>
      </div>
    </aside>

    <div class="body__copy">
      <p class="p p--lead">
        <span class="drop">{lang === "it" ? "N" : "B"}</span>{runs(t("bio.p1")).map((r) => (
          r.italic ? <span class="serif-italic">{r.text}</span> : <Fragment>{r.text}</Fragment>
        ))}
      </p>
      {["bio.p2", "bio.p3", "bio.p4", "bio.p5"].map((key) => (
        <p class="p">{runs(t(key)).map((r) => (
          r.italic ? <span class="serif-italic">{r.text}</span> : <Fragment>{r.text}</Fragment>
        ))}</p>
      ))}
    </div>
  </section>

  <!-- PHOTOS -->
  <section class="photos">
    <div class="photos__grid photos__grid--two">
      <div class="photos__item">
        <img src="/assets/ar-stairs.jpg" alt="Andrea Ricciotti" loading="lazy" />
      </div>
      <div class="photos__item">
        <img src="/assets/ar-02995.jpg" alt="Andrea Ricciotti" loading="lazy" />
      </div>
    </div>
  </section>

  <Marquee
    items={["Avid Media Composer", "Adobe Premiere", "DaVinci Resolve", "Pro Tools", "Frame.io"]}
    speed={50}
    invert={true}
    separator="/"
  />

  <!-- TIMELINE -->
  <section class="timeline">
    <header class="timeline__head">
      <span class="mono">{t("bio.tl_section")}</span>
      <h2 class="display timeline__title">{t("bio.tl_title")}</h2>
    </header>
    <ol class="timeline__list">
      {timeline.map((t, i) => (
        <li class="t-row">
          <div class="t-row__n mono">{String(i + 1).padStart(2, "0")}</div>
          <div class="t-row__year mono">{t.year}</div>
          <div class="t-row__title display">{t.title}</div>
          <div class="t-row__body">{t.body}</div>
        </li>
      ))}
    </ol>
  </section>

  <!-- CLOSE -->
  <section class="close">
    <h2 class="close__title display">
      {t("bio.close")} <span class="serif-italic hot">{t("bio.close_it")}</span>
    </h2>
    <a href={L("/contact")} class="btn btn--hot">
      <span>{t("home.cta_brief")}</span><span>→</span>
    </a>
    <div class="close__fine mono">© {new Date().getFullYear()} · Andrea Ricciotti · {t("home.photo_caption")}, IT</div>
  </section>
</BaseLayout>

<style>
  /* HEAD */
  .head {
    padding: clamp(2rem, 4vw, 3rem) var(--gutter) clamp(1.5rem, 3vw, 2.5rem);
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .head__top {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px dashed var(--rule-soft);
    margin-bottom: 1.5rem;
  }
  .head__title {
    font-size: clamp(2.6rem, 8vw, 7.5rem);
    line-height: 0.88;
    color: var(--ink);
  }
  .head__title span { display: inline-block; margin-right: 0.25em; }
  .head__title .serif-italic { text-transform: none; color: var(--hot); }
  .head__lede {
    margin-top: 1.5rem;
    max-width: 58ch;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.5;
    color: var(--ink-mute);
  }

  /* FACTS */
  .facts {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    border-bottom: var(--rule-w) solid var(--rule);
  }
  @media (max-width: 960px) { .facts { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 560px) { .facts { grid-template-columns: repeat(2, 1fr); } }

  .fact {
    padding: 1rem var(--gutter);
    border-right: var(--rule-w) solid var(--rule);
  }
  .fact:last-child { border-right: 0; }
  @media (max-width: 960px) {
    .fact:nth-child(3n) { border-right: 0; }
    .fact:nth-child(-n+3) { border-bottom: var(--rule-w) solid var(--rule); }
  }
  @media (max-width: 560px) {
    .fact:nth-child(2n) { border-right: 0; }
    .fact:nth-child(3n) { border-right: var(--rule-w) solid var(--rule); }
    .fact { border-bottom: var(--rule-w) solid var(--rule); }
    .fact:nth-last-child(-n+2) { border-bottom: 0; }
  }
  .fact__k { color: var(--ink-faint); margin-bottom: 0.25rem; font-size: 0.58rem; }
  .fact__v { font-size: 1.15rem; color: var(--ink); }

  /* BODY */
  .body {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 0;
    border-bottom: var(--rule-w) solid var(--rule);
  }
  @media (max-width: 900px) { .body { grid-template-columns: 1fr; } }

  .body__aside {
    padding: clamp(2rem, 4vw, 3.5rem) var(--gutter);
    border-right: var(--rule-w) solid var(--rule);
    position: sticky;
    top: 64px;
    align-self: start;
    background: var(--paper-dim);
  }
  @media (max-width: 900px) { .body__aside { position: static; border-right: 0; border-bottom: var(--rule-w) solid var(--rule); } }
  .body__label { color: var(--hot); margin-bottom: 1.5rem; }

  .downloads { display: flex; flex-direction: column; gap: 0; }
  .dl {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 1rem 0;
    border-top: 1px solid var(--rule-soft);
    transition: color var(--dur-fast) var(--ease), padding var(--dur-fast) var(--ease);
    color: var(--ink);
  }
  .dl:last-child { border-bottom: 1px solid var(--rule-soft); }
  .dl:hover { color: var(--hot); padding-left: 0.5rem; }
  .dl .display { font-size: clamp(1.2rem, 2vw, 1.6rem); }

  .body__copy {
    padding: clamp(2rem, 4vw, 3.5rem) var(--gutter);
    max-width: 74ch;
  }
  .p {
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.6;
    color: var(--ink);
    margin-bottom: 1.25rem;
  }
  .p--lead { font-size: clamp(1.2rem, 1.6vw, 1.4rem); }
  .p .serif-italic { color: var(--hot); }
  .drop {
    font-family: var(--font-display);
    float: left;
    font-size: 4.8em;
    line-height: 0.82;
    padding: 0.08em 0.1em 0 0;
    color: var(--hot);
  }

  /* TIMELINE */
  .timeline {
    padding: clamp(3rem, 6vw, 5rem) var(--gutter);
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .timeline__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px dashed var(--rule-soft);
  }
  .timeline__title {
    font-size: clamp(2rem, 5vw, 4rem);
    color: var(--ink);
    line-height: 0.9;
  }

  .timeline__list { list-style: none; padding: 0; margin: 0; }
  .t-row {
    display: grid;
    grid-template-columns: 2.5rem 10rem 1fr 1.5fr;
    gap: 1rem;
    align-items: baseline;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--rule-soft);
    transition: background var(--dur-fast) var(--ease);
    padding-left: 0.25rem;
    padding-right: 0.25rem;
  }
  .t-row:hover { background: var(--paper-dim); }
  .t-row__n { color: var(--ink-faint); }
  .t-row__year { color: var(--hot); }
  .t-row__title { font-size: clamp(1.1rem, 1.6vw, 1.4rem); color: var(--ink); }
  .t-row__body { color: var(--ink-mute); font-size: 0.95rem; line-height: 1.5; }

  @media (max-width: 820px) {
    .t-row {
      grid-template-columns: 2rem 1fr;
      row-gap: 0.3rem;
    }
    .t-row__year { grid-column: 2; }
    .t-row__title { grid-column: 2; }
    .t-row__body { grid-column: 2; }
  }

  /* CLOSE */
  .close {
    padding: clamp(4rem, 8vw, 7rem) var(--gutter);
    text-align: center;
  }
  .close__title {
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 0.95;
    color: var(--ink);
    margin-bottom: 2rem;
  }
  .close__title .serif-italic { color: var(--hot); text-transform: none; }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 1.5rem;
    border: var(--rule-w) solid var(--ink);
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 1.05rem;
    transition: all var(--dur-fast) var(--ease);
  }
  .btn--hot { background: var(--hot); color: var(--ink); }
  .btn--hot:hover { background: var(--ink); color: var(--hot); }
  .close__fine { margin-top: 3rem; color: var(--ink-faint); font-size: 0.6rem; }

  /* PHOTOS */
  .photos {
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .photos__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 0;
  }
  .photos__grid--two {
    grid-template-columns: 1fr 1fr;
  }
  @media (max-width: 700px) {
    .photos__grid { grid-template-columns: 1fr 1fr; }
  }
  .photos__item {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-right: var(--rule-w) solid var(--rule);
    background: var(--ink);
  }
  .photos__item:last-child { border-right: 0; }
  .photos__item img {
    width: 100%; height: 100%;
    object-fit: cover;
    filter: grayscale(0.2) contrast(1.05);
    transition: transform var(--dur-med) var(--ease), filter var(--dur-med) var(--ease);
  }
  .photos__item:hover img {
    transform: scale(1.04);
    filter: grayscale(0) contrast(1.08);
  }
  .photos__cap {
    position: absolute;
    bottom: 0.75rem; left: 0.75rem;
    background: var(--paper);
    color: var(--ink-mute);
    padding: 0.2rem 0.5rem;
    font-size: 0.55rem;
    border: 1px solid var(--ink);
  }
</style>
